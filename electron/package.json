{
  "name": "datafall",
  "version": "1.0.0",
  "description": "DataFall - A Cyberpunk Idle Tycoon Game",
  "main": "main.js",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:dev": "NODE_ENV=development electron .",
    "build:win": "electron-packager . DataFall --platform=win32 --arch=x64 --out=dist --overwrite --asar.unpackDir=\"node_modules/steamworks.js\" --icon=icon.ico",
    "build:mac": "electron-packager . DataFall --platform=darwin --arch=x64 --out=dist --overwrite --asar.unpackDir=\"node_modules/steamworks.js\" --icon=icon.icns",
    "build:linux": "electron-packager . DataFall --platform=linux --arch=x64 --out=dist --overwrite --asar.unpackDir=\"node_modules/steamworks.js\""
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-packager": "^17.1.2"
  }
}
